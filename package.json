{
  "name": "english-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet English companion for Windows",
  "author": "English Buddy",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/*.mjs",
    "test": "vitest run",
    "build": "npm run native && node scripts/build.mjs",
    "start": "electron .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:desktop": "node scripts/desktop-test.mjs",
    "package": "npm run build && electron-builder --win nsis portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
